{
  "name": "ars-rag-search-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare-data": "tsx src/prepare-data.ts",
    "build-index": "tsx --env-file-if-exists=.env src/build-index.ts",
    "search": "tsx --env-file-if-exists=.env src/search.ts",
    "ask": "tsx --env-file-if-exists=.env src/answer.ts",
    "ui": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.0"
  }
}
