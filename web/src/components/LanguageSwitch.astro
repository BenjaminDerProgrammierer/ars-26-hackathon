---
import {
  type Lang,
  languages,
  localizedPathname,
  useTranslations,
} from "../i18n/ui";

interface Props {
  lang: Lang;
  availableLangs?: Lang[];
}

const { lang, availableLangs = Object.keys(languages) as Lang[] } = Astro.props;
const t = useTranslations(lang);

const targets = availableLangs.map((code) => ({
  code,
  label: languages[code],
  url: localizedPathname(Astro.url.pathname, code),
  current: code === lang,
}));
---

<nav class="lang-switch" aria-label={t("lang.switch.label")}>
  {
    targets.map((target) => (
      <a
        href={target.url}
        lang={target.code}
        hreflang={target.code}
        aria-current={target.current ? "true" : undefined}
        data-language-switch-link
      >
        {target.label}
      </a>
    ))
  }
</nav>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "[data-language-switch-link]",
  )) {
    link.search = window.location.search;
    link.hash = window.location.hash;
  }
</script>

<style>
  .lang-switch {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  a {
    text-decoration: none;
    color: var(--color-muted);
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  a[aria-current="true"] {
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
</style>
