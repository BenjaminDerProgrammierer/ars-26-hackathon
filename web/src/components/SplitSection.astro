---
/**
 * Asymmetrical two-column story section: media ~2/3, text ~1/3.
 * Set `flip` to alternate the media side between sections.
 * On narrow screens the heading comes before the media.
 */
interface Props {
  flip?: boolean;
}

const { flip = false } = Astro.props;
---

<section class:list={["split", { flip }]}>
  <div class="wrap grid">
    <div class="heading">
      <slot name="heading" />
    </div>
    <div class="media">
      <slot name="media" />
    </div>
    <div class="text">
      <slot />
    </div>
  </div>
</section>

<style>
  .split {
    padding-block: var(--space-7);
  }

  .grid {
    display: grid;
    gap: var(--space-6);
  }

  .heading :global(h2) {
    margin-bottom: 0;
    font-size: var(--text-xl);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 2fr 1fr;
      grid-template-areas:
        "media heading"
        "media text";
      align-content: center;
      column-gap: var(--space-6);
      row-gap: var(--space-2);
    }

    .flip .grid {
      grid-template-columns: 1fr 2fr;
      grid-template-areas:
        "heading media"
        "text media";
    }

    .heading {
      grid-area: heading;
      align-self: end;
    }

    .media {
      grid-area: media;
      align-self: center;
    }

    .text {
      grid-area: text;
      align-self: start;
    }
  }

  .media :global(> *) {
    width: 100%;
  }

  .text :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
