---
interface Props {
  lang: "en" | "de";
}

const { lang } = Astro.props;
---

{
  lang === "en" && (
    <aside class="language-notice" aria-label="Content language" lang="en">
      <strong>German learning content:</strong> This partially bilingual site
      provides tutorials and walkthroughs in German on both the English and
      German routes.
    </aside>
  )
}

<style>
  .language-notice {
    border-left: 4px solid var(--color-action);
    background: var(--color-wash);
    padding: var(--space-4);
    margin-bottom: var(--space-7);
  }
</style>
