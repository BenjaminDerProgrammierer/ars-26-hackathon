---
interface Props {
  lang: "en" | "de";
}

const { lang } = Astro.props;
---

{
  lang === "en" && (
    <aside class="language-notice" aria-label="Content language" lang="en">
      <strong>German content:</strong> No English version is currently available.
      The complete German content is displayed below.
    </aside>
  )
}

<style>
  .language-notice {
    border-left: 4px solid var(--color-action);
    background: var(--color-wash);
    padding: var(--space-4);
    margin-bottom: var(--space-7);
  }
</style>
