---
import { getCollection } from "astro:content";
import ContentLanguageNotice from "../../../components/ContentLanguageNotice.astro";
import { href, type Lang } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "de" } }];
}

const lang = Astro.params.lang as Lang;
const tutorials = (
  await getCollection("tutorials", (entry) => entry.id.startsWith("de/"))
).sort((a, b) => a.data.order - b.data.order);
const walkthroughs = (
  await getCollection("walkthroughs", (entry) => entry.id.startsWith("de/"))
).sort((a, b) => a.data.order - b.data.order);

const intro =
  "Tutorials vermitteln die Grundlagen. In den Walkthroughs wählt ihr selbst, wie viel Unterstützung ihr für ein konkretes Projekt möchtet.";
---

<BaseLayout
  lang={lang}
  title="Tutorials & Walkthroughs"
  description={intro}
>
  <section class="title-band" lang="de">
    <div class="wrap">
      <h1>Tutorials & Walkthroughs</h1>
      <p class="intro">{intro}</p>
    </div>
  </section>

  {
    lang === "en" && (
      <div class="wrap">
        <ContentLanguageNotice lang={lang} />
      </div>
    )
  }

  <section
    class="resource-section"
    aria-labelledby="tutorials-title"
    lang="de"
  >
    <div class="wrap">
      <p class="eyebrow">Grundlagen</p>
      <h2 id="tutorials-title">Tutorials</h2>
      <p class="section-intro">
        Richtet eure Entwicklungsumgebung ein und lernt, wie ihr pi.dev und
        gute Prompts für euer Projekt nutzt.
      </p>
      <ol class="resource-list">
        {
          tutorials.map((tutorial) => {
            const slug = tutorial.id.split("/")[1];
            return (
              <li>
                <span class="number">
                  {String(tutorial.data.order).padStart(2, "0")}
                </span>
                <div>
                  <h3>
                    <a href={href(lang, `tutorials/${slug}`)}>
                      {tutorial.data.title}
                    </a>
                  </h3>
                  <p>{tutorial.data.description}</p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <section
    class="resource-section walkthrough-section"
    aria-labelledby="walkthroughs-title"
    lang="de"
  >
    <div class="wrap">
      <p class="eyebrow">Konkrete Projekte</p>
      <h2 id="walkthroughs-title">Walkthroughs</h2>
      <p class="section-intro">
        Entscheidet bei jedem Projekt, ob ihr nur einen Ideenanstoß, zusätzlich
        passende Prompts oder gleich den vollständigen Beispielcode möchtet.
      </p>
      <div class="walkthrough-grid">
        {
          walkthroughs.map((walkthrough) => {
            const slug = walkthrough.id.split("/")[1];
            const walkthroughUrl = href(lang, `walkthroughs/${slug}`);
            return (
              <article class="walkthrough-card">
                <p class="number">
                  {String(walkthrough.data.order).padStart(2, "0")}
                </p>
                <h3>
                  <a href={`${walkthroughUrl}ideenhilfe/`}>
                    {walkthrough.data.title}
                  </a>
                </h3>
                <p>{walkthrough.data.description}</p>
                <nav aria-label={`Pfad für ${walkthrough.data.title}`}>
                  <a href={`${walkthroughUrl}ideenhilfe/`}>Ideenhilfe</a>
                  <a href={`${walkthroughUrl}ideen-und-prompts/`}>
                    Ideen + Prompts
                  </a>
                  <a href={`${walkthroughUrl}vollstaendiger-code/`}>
                    Vollständiger Code
                  </a>
                </nav>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .title-band {
    background: var(--color-program);
    color: var(--color-ink);
    padding-block: var(--space-7);
    margin-bottom: var(--space-7);
  }

  .title-band :global(:focus-visible) {
    outline-color: var(--color-ink);
  }

  h1 {
    font-size: var(--text-2xl);
    text-transform: uppercase;
    margin: 0;
  }

  .intro {
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
    font-weight: 500;
    max-width: var(--width-reading);
  }

  .resource-section {
    padding-block: 0 var(--space-8);
  }

  .walkthrough-section {
    background: var(--color-wash);
    padding-block: var(--space-7);
  }

  .eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--text-2xl);
    text-transform: uppercase;
  }

  .section-intro {
    max-width: var(--width-reading);
    margin-bottom: var(--space-6);
  }

  .resource-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .resource-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  .resource-list li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .number {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-program);
    line-height: 1;
  }

  h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .resource-list p,
  .walkthrough-card > p:last-of-type {
    margin: 0;
    color: var(--color-muted);
  }

  .walkthrough-grid {
    display: grid;
    gap: var(--space-5);
  }

  .walkthrough-card {
    background: var(--color-paper);
    border-top: 4px solid var(--color-program);
    padding: var(--space-5);
  }

  .walkthrough-card .number {
    margin-bottom: var(--space-4);
  }

  .walkthrough-card nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .walkthrough-card nav a {
    display: inline-block;
    border: 1px solid var(--color-ink);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .walkthrough-card nav a:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  @media (min-width: 48rem) {
    .walkthrough-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
