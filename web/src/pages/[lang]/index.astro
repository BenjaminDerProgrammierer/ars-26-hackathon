---
import ColorBand from "../../components/ColorBand.astro";
import Hero from "../../components/Hero.astro";
import Milestones from "../../components/Milestones.astro";
import SplitSection from "../../components/SplitSection.astro";
import { signUpUrl } from "../../config";
import { href, type Lang, useTranslations } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "de" } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const copy = {
  en: {
    title: "AI Hackathon",
    heroKicker: "A sub-event of Ars Electronica Festival 2026",
    intro:
      "Develop apps, guides, interactive maps, storytelling tools, artistic AI projects, or entirely new ideas that combine the festival program dataset with open data from the City of Linz. We will develop and experiment together for two days, and the best projects will be honored on the third day. The goal is to find new approaches that let people experience Linz and the festival differently.",
    primaryAction: "Sign up now",
    secondaryAction: "How the hackathon works",
    statement: "Linz neu entdecken",
    registration: {
      heading: "Registration at a glance",
      deadlineLabel: "Deadline",
      deadline: "August 31, 2026",
      eligibilityLabel: "Who can join",
      eligibility:
        "Anyone aged 14 or older — no prior coding experience required",
      teamsLabel: "Participation",
      teams:
        "Join alone, request team matching, or participate as an existing team of two to five people",
      costLabel: "Cost",
      cost: "Free; registration is required",
    },
    datasets: {
      heading: "Two data worlds to combine",
      festivalLabel: "Festival program dataset",
      festivalBody:
        "Use the Festival 2026 program dataset to explore the festival from new angles.",
      openDataLabel: "City of Linz open data",
      openDataBody:
        "Combine it with a curated selection of open city data to create new ways of experiencing Linz.",
      link: "Explore the datasets",
    },
    tutorials: {
      heading: "Tutorials and walkthroughs",
      body: "The German learning section offers three short tutorials on setup, pi.dev, and prompting, plus three project walkthroughs with selectable levels of support.",
      link: "Open the German resources",
    },
    agents: {
      heading: "Development & AI, your choice",
      body: "When registering, choose from three options: work with your own setup, use OpenRouter access to Mistral Medium 3.5 with a budget of $20 per person, or choose a fully browser-based development environment hosted in Austria with pi.dev preinstalled. The AI add-on is also required to use the hosted development environment.",
      link: "Explore the development options",
    },
    milestonesHeading: "What happens when",
    milestones: [
      {
        date: "July 21–August 31, 2026",
        title: "Registration",
        detail: "Register for free on the City of Linz participation platform.",
      },
      {
        date: "Mid-August 2026",
        title: "Practical information",
        detail:
          "Registered participants receive the detailed schedule by email.",
      },
      {
        date: "September 11, 2026",
        title: "Kick-off & team matching",
        detail: "Meet the data, the agents, and your future teammates.",
      },
      {
        date: "September 11–12, 2026",
        title: "Hacking",
        detail:
          "Build and experiment with mentor support. On September 12, present your project or demo to the jury in a short pitch before jury voting.",
      },
      {
        date: "September 13, 2026, 12:00–13:00 — Hauptplatz Linz",
        title: "Award ceremony",
        detail: "The winning teams are honored at the award ceremony.",
      },
    ],
  },
  de: {
    title: "AI Hackathon",
    heroKicker: "Ein Sub-Event des Ars Electronica Festival 2026",
    intro:
      "Entwickelt Apps, Guides, interaktive Karten, Storytelling-Tools, künstlerische KI-Projekte oder ganz neue Ideen, die den Programmdatensatz des Festivals mit offenen Daten der Stadt Linz verbinden. Zwei Tage lang wird gemeinsam entwickelt und experimentiert, am dritten Tag werden die besten Projekte ausgezeichnet. Ziel sind neue Ansätze, die Linz und das Festival anders erlebbar machen.",
    primaryAction: "Jetzt anmelden",
    secondaryAction: "So funktioniert der Hackathon",
    statement: "Linz neu entdecken",
    registration: {
      heading: "Anmeldung auf einen Blick",
      deadlineLabel: "Anmeldeschluss",
      deadline: "31. August 2026",
      eligibilityLabel: "Wer teilnehmen kann",
      eligibility:
        "Alle ab 14 Jahren — Coding-Erfahrung ist nicht erforderlich",
      teamsLabel: "Teilnahme",
      teams:
        "Teilnehmen könnt ihr allein, mit Team-Zuteilung oder als bereits bestehendes Team mit zwei bis fünf Personen",
      costLabel: "Kosten",
      cost: "Kostenlos; Anmeldung erforderlich",
    },
    datasets: {
      heading: "Zwei Datenwelten zum Kombinieren",
      festivalLabel: "Festival-Programmdatensatz",
      festivalBody:
        "Nutzt den Programmdatensatz des Festivals 2026, um das Festival aus neuen Blickwinkeln zu erkunden.",
      openDataLabel: "Open Data der Stadt Linz",
      openDataBody:
        "Kombiniert ihn mit einer kuratierten Auswahl offener Stadtdaten und schafft neue Zugänge zu Linz.",
      link: "Zu den Datensätzen",
    },
    tutorials: {
      heading: "Tutorials und Walkthroughs",
      body: "Drei kurze Tutorials erklären Setup, pi.dev und gute Prompts. In drei Projekt-Walkthroughs wählt ihr zwischen Ideenhilfe, Idee plus Prompts und vollständigem Beispielcode.",
      link: "Zu den Tutorials & Walkthroughs",
    },
    agents: {
      heading: "Entwicklung & KI nach Wahl",
      body: "Bei der Anmeldung wählt ihr zwischen drei Optionen: Ihr arbeitet mit eurem eigenen Setup, nutzt einen OpenRouter-Zugang zu Mistral Medium 3.5 mit einem Budget von 20 US-Dollar pro Person oder entscheidet euch für eine vollständig browserbasierte, in Österreich gehostete Entwicklungsumgebung mit vorinstalliertem pi.dev. Für die Nutzung der gehosteten Entwicklungsumgebung wird zusätzlich das KI-Add-on benötigt.",
      link: "Zu den Entwicklungsoptionen",
    },
    milestonesHeading: "Was passiert wann",
    milestones: [
      {
        date: "21. Juli–31. August 2026",
        title: "Anmeldung",
        detail:
          "Meldet euch kostenlos auf der Partizipationsplattform der Stadt Linz an.",
      },
      {
        date: "Mitte August 2026",
        title: "Praktische Informationen",
        detail:
          "Angemeldete Teilnehmer:innen erhalten den genauen Ablauf per E-Mail.",
      },
      {
        date: "11. September 2026",
        title: "Kick-off & Team-Matching",
        detail: "Lernt die Daten, die Agents und eure künftigen Teams kennen.",
      },
      {
        date: "11.–12. September 2026",
        title: "Hacken",
        detail:
          "Entwickelt und experimentiert mit Mentoring. Am 12. September stellt ihr eure Projekte oder Demos der Jury in kurzen Pitches vor; anschließend findet das Jury-Voting statt.",
      },
      {
        date: "13. September 2026, 12:00–13:00 Uhr — Hauptplatz Linz",
        title: "Siegerehrung",
        detail: "Die Gewinnerteams werden bei der Siegerehrung ausgezeichnet.",
      },
    ],
  },
}[lang];
---

<BaseLayout lang={lang} title={copy.title} description={copy.intro}>
  <Hero title={copy.title} kicker={copy.heroKicker} datePlace={t("site.datePlace")} />

  <section class="intro">
    <div class="wrap wrap--reading">
      <p>{copy.intro}</p>
      <p class="actions">
        <a class="button button--action" href={signUpUrl}>{copy.primaryAction}</a>
        <a class="secondary" href={href(lang, "hackathon")}>{copy.secondaryAction}</a>
      </p>
    </div>
  </section>

  <section class="registration" aria-labelledby="registration-title">
    <div class="wrap">
      <h2 id="registration-title">{copy.registration.heading}</h2>
      <dl>
        <div>
          <dt>{copy.registration.deadlineLabel}</dt>
          <dd>{copy.registration.deadline}</dd>
        </div>
        <div>
          <dt>{copy.registration.eligibilityLabel}</dt>
          <dd>{copy.registration.eligibility}</dd>
        </div>
        <div>
          <dt>{copy.registration.teamsLabel}</dt>
          <dd>{copy.registration.teams}</dd>
        </div>
        <div>
          <dt>{copy.registration.costLabel}</dt>
          <dd>{copy.registration.cost}</dd>
        </div>
      </dl>
    </div>
  </section>

  <SplitSection>
    <div slot="media" class="media-field">
      <span class="section-mark section-mark--identity" aria-hidden="true">01</span>
    </div>
    <h2 slot="heading">{copy.datasets.heading}</h2>
    <div class="data-world">
      <h3>{copy.datasets.festivalLabel}</h3>
      <p>{copy.datasets.festivalBody}</p>
    </div>
    <div class="data-world">
      <h3>{copy.datasets.openDataLabel}</h3>
      <p>{copy.datasets.openDataBody}</p>
    </div>
    <p><a href={href(lang, "datasets")}>{copy.datasets.link}</a></p>
  </SplitSection>

  <ColorBand color="var(--color-program)">
    <p>{copy.statement}</p>
  </ColorBand>

  <SplitSection flip>
    <div slot="media" class="media-field">
      <span class="section-mark section-mark--program" aria-hidden="true">02</span>
    </div>
    <h2 slot="heading">{copy.tutorials.heading}</h2>
    <p>{copy.tutorials.body}</p>
    <p>
      <a href={href(lang, "tutorials")}>{copy.tutorials.link}</a>
    </p>
  </SplitSection>

  <SplitSection>
    <div slot="media" class="media-field">
      <span class="section-mark section-mark--context" aria-hidden="true">03</span>
    </div>
    <h2 slot="heading">{copy.agents.heading}</h2>
    <p>{copy.agents.body}</p>
    <p><a href={href(lang, "coding-agents")}>{copy.agents.link}</a></p>
  </SplitSection>

  <Milestones heading={copy.milestonesHeading} items={copy.milestones} />
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-7) 0;
  }

  .intro p:first-child {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  .registration {
    padding-block: var(--space-7);
  }

  .registration h2 {
    font-size: var(--text-xl);
    text-transform: uppercase;
  }

  .registration dl {
    display: grid;
    margin: 0;
    border-top: 3px solid var(--color-action);
  }

  .registration dl > div {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-rule);
  }

  .registration dt {
    margin-bottom: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
  }

  .registration dd {
    margin: 0;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .registration dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .registration dl > div:nth-child(odd) {
      padding-right: var(--space-6);
    }

    .registration dl > div:nth-child(even) {
      padding-left: var(--space-6);
      border-left: 1px solid var(--color-rule);
    }
  }

  .media-field {
    background: var(--color-wash);
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 2;
  }

  .section-mark {
    font-size: clamp(5rem, 16vw, 10rem);
    font-weight: 700;
    line-height: 1;
  }

  .section-mark--identity {
    color: var(--color-identity);
  }

  .section-mark--program {
    color: var(--color-program);
  }

  .section-mark--context {
    color: var(--color-context);
  }

  .data-world + .data-world {
    border-top: 1px solid var(--color-rule);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
  }

  .data-world h3 {
    font-size: var(--text-base);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
</style>
