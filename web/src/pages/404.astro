---
import { href, langFromPathname } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

const lang = langFromPathname(Astro.originPathname);
const copy = {
  en: {
    message: "This page does not exist — yet.",
    home: "To the hackathon",
    otherHome: "Zum Hackathon",
  },
  de: {
    message: "Diese Seite existiert nicht — noch nicht.",
    home: "Zum Hackathon",
    otherHome: "To the hackathon",
  },
}[lang];
const otherLang = lang === "de" ? "en" : "de";
---

<BaseLayout lang={lang} title="404">
  <section class="notfound">
    <div class="wrap wrap--reading">
      <h1>404</h1>
      <p>{copy.message}</p>
      <p>
        <a class="button" href={href(lang)}>{copy.home}</a>
        <a class="button button--outline" href={href(otherLang)}
          >{copy.otherHome}</a
        >
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-8);
  }

  h1 {
    font-size: var(--text-display);
    color: var(--color-identity);
  }

  p:last-child {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
