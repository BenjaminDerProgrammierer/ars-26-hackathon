---
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LocalNav from "../components/LocalNav.astro";
import {
  type Lang,
  languages,
  localizedPathname,
  useTranslations,
} from "../i18n/ui";
import "../styles/global.css";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  robots?: string;
  availableLangs?: Lang[];
}

const {
  lang,
  title,
  description,
  robots,
  availableLangs = Object.keys(languages) as Lang[],
} = Astro.props;
const t = useTranslations(lang);

const alternates = availableLangs.map((code) => ({
  code,
  url: localizedPathname(Astro.url.pathname, code),
}));

const skipLabel = lang === "de" ? "Zum Inhalt springen" : "Skip to content";

const siteName = `${t("site.title")} — ${t("site.affiliation")}`;
const pageTitle =
  title === t("site.title") ? siteName : `${title} // ${siteName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.code} href={alt.url} />
      ))
    }
    <Font cssVariable="--font-plex" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Header lang={lang} availableLangs={availableLangs} />
    <LocalNav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
